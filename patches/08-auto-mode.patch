+    def _auto_mode(self, messages, kwargs):
+        """local patch (2026-10-18): no {REASON:} written by the client -> prepend the mode the question asks for
+        (serve/auto_mode.py).  The choice is kept per conversation, keyed by the conversation's first user message, so
+        the mode does not flip between turns and the conversation cache keeps its prefix; the template strips the tag,
+        so the rendered history is identical whichever turn carries it."""
+        if not self.auto_mode:
+            return messages
+        first = last = None
+        for m in messages:
+            if m.get("role") == "user" and isinstance(m.get("content"), str) and m["content"].strip():
+                if first is None:
+                    first = m["content"]
+                last = m["content"]
+        if first is None or auto_mode_api.TAG in last:      # the client picked a mode itself: never second-guess it
+            return messages
+        key = first[:400]
+        mode = self.auto_modes.get(key)
+        if mode is None:
+            mode, why = auto_mode_api.choose(last)
+            if mode is None:
+                return messages
+            if len(self.auto_modes) >= 1024:
+                self.auto_modes.clear()
+            self.auto_modes[key] = mode
+            print(f"[strata] auto-mode: {mode} ({why}) for: {auto_mode_api.short(last)}", flush=True)
+        # `i` keeps a client's enable_thinking=false: the plain tag would turn thinking back on (the template's rule)
+        tag = auto_mode_api.TAG + ("i" if kwargs.get("enable_thinking") is False else "") + mode + "}"
+        out = list(messages)
+        for i in range(len(out) - 1, -1, -1):
+            m = out[i]
+            if m.get("role") == "user" and isinstance(m.get("content"), str) and m["content"].strip():
+                out[i] = dict(m, content=tag + " " + m["content"])
+                break
+        return out
+

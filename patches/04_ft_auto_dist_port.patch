+        return f"tcp://127.0.0.1:{os.getenv('FT_DIST_PORT', 2333)}"
diff --git a/freetoken/server/launch.py b/freetoken/server/launch.py
--- a/freetoken/server/launch.py
+++ b/freetoken/server/launch.py
@@ -128,7 +128,7 @@
     prog: str | None = None,
 ) -> None:
     from .api_server import run_api_server
-    from .args import parse_args
+    from .args import find_free_dist_port, parse_args
 
     server_args, run_shell = parse_args(
         sys.argv[1:] if argv is None else argv,
@@ -137,6 +137,20 @@
     )
     logger = init_logger(__name__, "initializer")
 
+    # [local patch] Resolve the rendezvous port ONCE, here in the parent, and export it so every
+    # spawned rank derives the same address (the worker-side `distributed_addr` property reads
+    # the environment; re-evaluating it per process would let ranks disagree). Previously
+    # `server_port + 1` was used blindly, so any process sitting on that port failed the launch.
+    explicit_port = os.environ.get("FT_DIST_PORT")
+    preferred_port = int(explicit_port) if explicit_port else server_args.server_port + 1
+    resolved_port = find_free_dist_port(preferred_port)
+    if resolved_port != preferred_port:
+        logger.warning(
+            f"rendezvous port {preferred_port} is in use; using {resolved_port} instead"
+            + (" (FT_DIST_PORT was set explicitly)" if explicit_port else "")
+        )
+    os.environ["FT_DIST_PORT"] = str(resolved_port)
+
     if server_args.gpu:
         # resolve here so a typo is one clear error before any worker spawns
         from freetoken.gpu_select import resolve_gpu_uuids

# 补丁 04：FT_DIST_PORT —— rendezvous 端口与 API 端口解耦
#
# 目标：freetoken==0.1.3 源码（装在 <venv>/lib/python3.12/site-packages 下）
# 原因：FreeToken 内部 torch.distributed rendezvous 默认监听「API 端口 + 1」，
#       而本项目要让 API 占 8000、nginx 继续占 8001 —— rendezvous 会直接撞上 8001。
#       改法：允许 FT_DIST_PORT 环境变量覆盖，本项目用 8002。
# 打法：cd <venv>/lib/python3.12/site-packages && patch -p1 < patches/04_ft_dist_port.patch
# 上游：无对应 issue（本项目自研，为兼容既有的 8000/8001 端口布局）
#
--- a/freetoken/server/args.py
+++ b/freetoken/server/args.py
@@ -101,7 +101,10 @@
 
     @property
     def distributed_addr(self) -> str:
-        return f"tcp://127.0.0.1:{self.server_port + 1}"
+        # [local patch] FT_DIST_PORT lets the torch.distributed rendezvous port differ from
+        # server_port+1, so the API can serve on 8000 while nginx keeps 8001.
+        port = int(os.getenv("FT_DIST_PORT", self.server_port + 1))
+        return f"tcp://127.0.0.1:{port}"
 
 
 def _json_object(text: str) -> dict:
--- a/freetoken/engine/config.py
+++ b/freetoken/engine/config.py
@@ -1,6 +1,7 @@
 from __future__ import annotations
 
 import copy
+import os
 from dataclasses import dataclass, field, replace
 from functools import cached_property
 from typing import TYPE_CHECKING, List
@@ -150,4 +151,5 @@
 
     @property
     def distributed_addr(self) -> str:
-        return "tcp://127.0.0.1:2333"
+        # [local patch] FT_DIST_PORT override (see freetoken/server/args.py)
+        return f"tcp://127.0.0.1:{os.getenv('FT_DIST_PORT', 2333)}"

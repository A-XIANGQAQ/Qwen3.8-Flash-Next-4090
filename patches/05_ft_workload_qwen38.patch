# 补丁 05：注册 qwen3.8-flash-next workload
#
# 目标：freetoken==0.1.3 源码（<venv>/lib/python3.12/site-packages）
# 原因：`ft bench bw` 的 nvfp4 结论是在 7.61MB 专家几何上测的，而本模型专家是
#       2.64MB（2560×640×3，NVFP4 + FP8 block scales），差 2.9 倍；--formats 只能改格式
#       不能改几何。没有这条，`--model qwen3.8-flash-next` 跑不了，只能得到一条无法执行的警告。
#       （实测：即便按真实几何重测，bench 仍判 hybrid，但实跑 offload 快 27%
#        —— 差异来自 decode batch size，bench 用合成批量、实际 bs≈1-2。）
# 打法：cd <venv>/lib/python3.12/site-packages && patch -p1 < patches/05_ft_workload_qwen38.patch
# 上游：PR #278「fix(moe): match the benchbw verdict to the served model's expert size」（OPEN）
#
--- a/freetoken/moe/benchbw.py
+++ b/freetoken/moe/benchbw.py
@@ -114,6 +114,8 @@
 # E/top_k/H/I are what drive the per-expert byte size and thus the bandwidths.
 WORKLOADS: dict[str, Workload] = {
     "qwen3.6-moe": Workload("qwen3.6-moe", 2048, 512, 256, 8, ("bf16", "nvfp4", "fp8_block")),
+    # [local patch] Qwen3.8-Flash-Next (qwen4_exp): H/I/E/top_k from the RadixArk NVFP4 config
+    "qwen3.8-flash-next": Workload("qwen3.8-flash-next", 2560, 640, 512, 10, ("nvfp4",)),
     "qwen3-30b": Workload("qwen3-30b", 2048, 768, 128, 8, ("bf16",)),
     "gemma4-26b": Workload("gemma4-26b", 2816, 704, 128, 8, ("bf16",), activation="gelu_tanh"),
     "gpt-oss-120b": Workload("gpt-oss-120b", 2880, 2880, 128, 4, ("mxfp4_triton",),

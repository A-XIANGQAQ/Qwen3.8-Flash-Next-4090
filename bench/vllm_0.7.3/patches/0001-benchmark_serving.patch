+def _synthetic_token_ids(tokenizer, n_tokens: int):
+    """Build n_tokens of valid text that round-trips through the tokenizer."""
+    n_words = int(n_tokens * 1.4) + 64
+    words = random.choices(_RANDOM_WORDS, k=n_words)
+    ids = tokenizer.encode(" ".join(words), add_special_tokens=False)
+    ids = ids[:n_tokens]
+    # A truncated byte-level sequence can end mid-codepoint; drop a trailing
+    # partial token so decode -> encode is exact.
+    for _ in range(8):
+        text = tokenizer.decode(ids)
+        roundtrip = tokenizer.encode(text, add_special_tokens=False)
+        if len(roundtrip) == len(ids):
+            return ids
+        ids = ids[:len(roundtrip)] if len(roundtrip) < len(ids) else ids[:-1]
+    return ids
+
